// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/typescript-node
{
  "name": "Node.js & TypeScript",
  // Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
  "image": "mcr.microsoft.com/devcontainers/typescript-node:24-trixie",
  "forwardPorts": [4200],


  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24.15.0"
    },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },
  "postCreateCommand": "bash .devcontainer/install_dependencies.sh",

  // Configure tool-specific properties.
  "customizations": {
    "vscode": {
      "extensions": [
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        "angular.ng-template"      ]
    }
  },


  "mounts": [
    "source=${devcontainerId}-claude-code-config,target=/home/node/.claude,type=volume",
    "source=${devcontainerId}-claude-code-bashhistory,target=/home/node/commandhistory,type=volume",
    "source=${devcontainerId}-nm,target=${containerWorkspaceFolder}/node_modules,type=volume"
  ]
}
